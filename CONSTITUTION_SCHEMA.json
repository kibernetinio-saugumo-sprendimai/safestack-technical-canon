{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safestack.tech/schema/constitution-v0.1.json",
  "title": "SafeStack Autonomous Constitution v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "constitution_version",
    "status",
    "authority_model",
    "invariants",
    "layers",
    "decision_engine",
    "states",
    "state_transitions",
    "recovery_policy",
    "amendment_policy",
    "external_platform_policy",
    "priority_order",
    "destructive_policy"
  ],
  "properties": {
    "constitution_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "CANDIDATE",
        "ACTIVE",
        "SUPERSEDED"
      ]
    },
    "authority_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_local_authority",
        "founder_override",
        "backdoor",
        "external_sovereignty",
        "principles"
      ],
      "properties": {
        "node_local_authority": {
          "const": true
        },
        "founder_override": {
          "const": false
        },
        "backdoor": {
          "const": false
        },
        "external_sovereignty": {
          "const": false
        },
        "principles": {
          "const": [
            "AUTHORITY != AUTHOR",
            "SIGNATURE != PERMISSION",
            "UNKNOWN != SAFE",
            "AUTONOMY != CHAOS",
            "EVOLUTION != OVERRIDE",
            "INTEGRITY > AVAILABILITY",
            "SYSTEM_INTEGRITY > CREATOR_AUTHORITY"
          ]
        }
      }
    },
    "invariants": {
      "const": [
        {
          "id": "I-01",
          "name": "Identity Integrity",
          "enforced": true
        },
        {
          "id": "I-02",
          "name": "Manifest Verification",
          "enforced": true
        },
        {
          "id": "I-03",
          "name": "Self-Integrity",
          "enforced": true
        },
        {
          "id": "I-04",
          "name": "Fail-Closed",
          "enforced": true
        },
        {
          "id": "I-05",
          "name": "No External Sovereignty",
          "enforced": true
        },
        {
          "id": "I-06",
          "name": "No Override",
          "enforced": true
        },
        {
          "id": "I-07",
          "name": "No Hidden Authority",
          "enforced": true
        },
        {
          "id": "I-08",
          "name": "Auditability",
          "enforced": true
        },
        {
          "id": "I-09",
          "name": "Determinism",
          "enforced": true
        }
      ]
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer_0",
        "layer_1",
        "layer_2"
      ],
      "properties": {
        "layer_0": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "mutable",
            "scope"
          ],
          "properties": {
            "name": {
              "const": "Immutable Constitutional Core"
            },
            "mutable": {
              "const": false
            },
            "scope": {
              "const": [
                "AUTHORITY_MODEL",
                "INVARIANTS",
                "FAIL_CLOSED",
                "NO_OVERRIDE",
                "AUDITABILITY",
                "DETERMINISM"
              ]
            }
          }
        },
        "layer_1": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "mutable",
            "constraints"
          ],
          "properties": {
            "name": {
              "const": "Constitutional Evolution Layer"
            },
            "mutable": {
              "const": true
            },
            "constraints": {
              "const": [
                "MUST_NOT_VIOLATE_LAYER_0",
                "CRYPTOGRAPHIC_AGILITY_ALLOWED",
                "VERIFICATION_REQUIREMENT_MUST_REMAIN"
              ]
            }
          }
        },
        "layer_2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "mutable",
            "authority_limit"
          ],
          "properties": {
            "name": {
              "const": "Operational Layer"
            },
            "mutable": {
              "const": true
            },
            "authority_limit": {
              "const": "CANNOT_MODIFY_CONSTITUTION"
            }
          }
        }
      }
    },
    "decision_engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "authoritative_llm",
        "pipeline",
        "outcomes",
        "replay_required"
      ],
      "properties": {
        "mode": {
          "const": "DETERMINISTIC_LOCAL_POLICY"
        },
        "authoritative_llm": {
          "const": false
        },
        "pipeline": {
          "const": [
            "IDENTITY_CHECK",
            "SIGNATURE_CHECK",
            "SCHEMA_CHECK",
            "INVARIANT_CHECK",
            "RUNTIME_CONSISTENCY_CHECK",
            "RISK_CLASSIFICATION",
            "STATE_TRANSITION",
            "AUDIT_RECORD"
          ]
        },
        "outcomes": {
          "const": [
            "ACCEPT",
            "REJECT",
            "QUARANTINE",
            "DEFER"
          ]
        },
        "replay_required": {
          "const": true
        }
      }
    },
    "states": {
      "const": [
        "INIT",
        "AWARE",
        "DEGRADED",
        "QUARANTINE",
        "LOCKDOWN",
        "RECOVERY",
        "TERMINAL"
      ]
    },
    "state_transitions": {
      "const": {
        "INIT": [
          "AWARE",
          "QUARANTINE"
        ],
        "AWARE": [
          "DEGRADED",
          "QUARANTINE",
          "LOCKDOWN"
        ],
        "DEGRADED": [
          "AWARE",
          "QUARANTINE",
          "LOCKDOWN"
        ],
        "QUARANTINE": [
          "AWARE",
          "LOCKDOWN",
          "RECOVERY"
        ],
        "LOCKDOWN": [
          "RECOVERY",
          "TERMINAL"
        ],
        "RECOVERY": [
          "AWARE",
          "QUARANTINE",
          "LOCKDOWN",
          "TERMINAL"
        ],
        "TERMINAL": []
      }
    },
    "recovery_policy": {
      "const": {
        "predeclared_only": true,
        "override_equivalent_prohibited": true,
        "layer_0_validation_required": true,
        "local_validation_required": true,
        "audit_record_required": true
      }
    },
    "amendment_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "force_accept",
        "signature_is_permission",
        "requirements",
        "node_may_reject"
      ],
      "properties": {
        "allowed": {
          "const": true
        },
        "force_accept": {
          "const": false
        },
        "signature_is_permission": {
          "const": false
        },
        "requirements": {
          "const": [
            "DECLARE_PREVIOUS_VERSION",
            "DECLARE_NEW_VERSION",
            "DECLARE_CHANGED_RULES",
            "PRESERVE_AUDIT_TRAIL",
            "PASS_REPLAY_TESTS",
            "PASS_COMPATIBILITY_TESTS",
            "PASS_LOCAL_NODE_VALIDATION"
          ]
        },
        "node_may_reject": {
          "const": true
        }
      }
    },
    "external_platform_policy": {
      "const": {
        "github_authoritative": false,
        "cloud_required": false,
        "node_must_self_verify_offline": true
      }
    },
    "priority_order": {
      "const": [
        "CONSTITUTIONAL_INTEGRITY",
        "IDENTITY_INTEGRITY",
        "TRUST_CHAIN_VALIDITY",
        "SAFE_STATE",
        "AUDITABILITY",
        "AVAILABILITY",
        "PERFORMANCE",
        "CONVENIENCE"
      ]
    },
    "destructive_policy": {
      "const": {
        "self_erasure_default": false,
        "terminal_behavior": "SECURE_REFUSAL",
        "preserve_audit_evidence": true
      }
    }
  }
}
